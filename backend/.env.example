# ==============================================================================
# EV SHOWROOM BACKEND ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# DO NOT PUT REAL PRODUCTION PASSWORDS OR SECRETS IN THIS FILE
# ==============================================================================

# Django Core
DJANGO_SECRET_KEY=django-insecure-change-this-to-a-random-50-character-secret-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# MySQL 8 Database Configuration
DB_NAME=ev_showroom_db
DB_USER=ev_user
DB_PASSWORD=ev_password_secure
DB_HOST=127.0.0.1
DB_PORT=3306

# SimpleJWT Settings
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_SIGNING_KEY=jwt-secret-key-change-this-in-production

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
