{
  "name": "voltix-ev-showroom-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Voltix EV Motors - Full-Stack Electric Vehicle Showroom Management System",
  "scripts": {
    "install": "npm install --prefix frontend",
    "install:all": "npm install --prefix frontend",
    "dev": "npm run dev --prefix frontend",
