    "server": "powershell -Command \"venv\\Scripts\\python backend\\manage.py runserver 127.0.0.1:8000\"",
    "test:backend": "powershell -Command \"venv\\Scripts\\python backend\\manage.py test apps\""
  },
  "keywords": [
    "ev",
    "showroom",
    "django",
    "react",
    "vite",
    "mysql"
  ],
