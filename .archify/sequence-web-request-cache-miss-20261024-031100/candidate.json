  "cards": [
    {
      "dot": "emerald",
      "title": "Cache Aside Architecture",
      "items": [
        "The Browser invokes the API endpoint to fetch resource details.",
        "The API checks the in-memory Redis cache first to minimize latency.",
        "A cache miss occurs when the key does not exist or has expired."
      ]
    },
    {
      "dot": "rose",
      "title": "Fallback & Database Fetch",
      "items": [
        "Upon cache miss, the API falls back to querying the PostgreSQL primary database.",
        "PostgreSQL executes the relational query and returns the record to the API handler.",
        "Database connections remain protected from heavy repetitive traffic by Redis."
      ]
    },
    {
      "dot": "cyan",
      "title": "Cache Population & Delivery",
      "items": [
        "The API populates Redis with the fetched record using SETEX with a TTL (e.g. 1 hour).",
        "Subsequent requests will hit Redis directly, bypassing PostgreSQL.",
        "The API responds to the Browser with 200 OK and the formatted JSON payload."
      ]
    }
  ]
